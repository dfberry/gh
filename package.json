{
  "scripts": {
    "build": "tsc -b",
    "test": "npm run test --workspaces --if-present",
    "test:dev": "npm run test --workspaces --if-present -- -w",
    "test:ci": "npm run test --workspaces --if-present -- --run",
    "run-all": "bash -lc 'mkdir -p ./generated && bash ./scripts/run-all.sh > ./generated/run-all.log 2>&1'",
    "run-all:dev": "bash -lc 'set -a; [ -f .env ] && source .env || true; mkdir -p ./generated && bash ./scripts/run-all.sh > ./generated/run-all-dev.log 2>&1'",
    "run-all:apply": "bash -lc 'mkdir -p ./generated && bash ./scripts/run-all.sh --apply > ./generated/run-all-apply.log 2>&1'",
    "run-gather": "bash -lc 'mkdir -p ./generated && bash ./scripts/run-gather.sh > ./generated/run-gather.log 2>&1'",
    "run-gather:dev": "bash -lc 'set -a; [ -f .env ] && source .env || true; mkdir -p ./generated && bash ./scripts/run-gather.sh > ./generated/run-gather-dev.log 2>&1'",
    "run-change": "bash -lc 'mkdir -p ./generated && bash ./scripts/run-change.sh > ./generated/run-change.log 2>&1'",
    "run-change:dev": "bash -lc 'set -a; [ -f .env ] && source .env || true; mkdir -p ./generated && bash ./scripts/run-change.sh > ./generated/run-change-dev.log 2>&1'",
    "run-evaluate": "bash -lc 'mkdir -p ./generated && bash ./scripts/run-evaluate.sh > ./generated/run-evaluate.log 2>&1'",
    "run-evaluate:dev": "bash -lc 'set -a; [ -f .env ] && source .env || true; mkdir -p ./generated && bash ./scripts/run-evaluate.sh > ./generated/run-evaluate-dev.log 2>&1'"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "packages/*"
  ]
}
