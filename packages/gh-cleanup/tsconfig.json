{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022","DOM"],
    "strict": true,
    "esModuleInterop": false,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "dist",
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
  ,
  "references": [
    { "path": "../github-rest" },
    { "path": "../llm-completion" }
  ]
}
